# Copy to .env.local to change how the frontend finds its data.

# Read the static JSON the backend commits to public/data/ instead of /api/*.
# Build-time setting: rebuild after changing it.
NEXT_PUBLIC_USE_FIXTURES=false

# Where fixture JSON is served from when NEXT_PUBLIC_USE_FIXTURES=true.
# NEXT_PUBLIC_FIXTURE_BASE=/data

# `npm run dev` proxies /api/* and /static/* here (`npx wrangler dev`).
# API_PROXY_TARGET=http://127.0.0.1:8787
