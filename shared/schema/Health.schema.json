{
  "$defs": {
    "UpstreamStatus": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "reachable": {
          "description": "True only when the upstream answered a minimal valid request with HTTP 200 and the expected body",
          "title": "Reachable",
          "type": "boolean"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "probed_utc": {
          "description": "When this result was measured",
          "title": "Probed Utc",
          "type": "string"
        },
        "cached": {
          "description": "Result reused from a probe in the last 10 minutes",
          "title": "Cached",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "url",
        "reachable",
        "probed_utc",
        "cached"
      ],
      "title": "UpstreamStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "pipeline_version": {
      "description": "Pipeline package version plus the git commit of the code that built the data",
      "title": "Pipeline Version",
      "type": "string"
    },
    "build_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "build_run_id of the static data being served",
      "title": "Build Run Id"
    },
    "status": {
      "enum": [
        "ok",
        "degraded"
      ],
      "title": "Status",
      "type": "string"
    },
    "checked_utc": {
      "title": "Checked Utc",
      "type": "string"
    },
    "fields_loaded": {
      "title": "Fields Loaded",
      "type": "integer"
    },
    "candidates_loaded": {
      "title": "Candidates Loaded",
      "type": "integer"
    },
    "upstream": {
      "items": {
        "$ref": "#/$defs/UpstreamStatus"
      },
      "title": "Upstream",
      "type": "array"
    }
  },
  "required": [
    "pipeline_version",
    "build_run_id",
    "status",
    "checked_utc",
    "fields_loaded",
    "candidates_loaded",
    "upstream"
  ],
  "title": "Health",
  "type": "object"
}
