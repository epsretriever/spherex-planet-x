      "type": "string"
    },
    "fields_loaded": {
      "title": "Fields Loaded",
      "type": "integer"
    },
    "candidates_loaded": {
      "title": "Candidates Loaded",
      "type": "integer"
    },
    "upstream": {
      "items": {
        "$ref": "#/$defs/UpstreamStatus"
      },
      "title": "Upstream",
      "type": "array"
    }
