{
  "$defs": {
    "LinkingValidationRow": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "eligible": {
          "description": "Both halves have the visits an orbit link needs",
          "title": "Eligible",
          "type": "boolean"
        },
        "n_a": {
          "title": "N A",
          "type": "integer"
        },
        "n_b": {
          "title": "N B",
          "type": "integer"
        },
        "gap_hours": {
          "title": "Gap Hours",
          "type": "number"
        },
        "rejoined": {
          "title": "Rejoined",
          "type": "boolean"
        },
        "decoys_linked": {
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Shifted copies of the second half, by offset in arcsec",
          "title": "Decoys Linked",
          "type": "object"
        }
      },
      "required": [
        "candidate_id",
        "eligible",
        "n_a",
        "n_b",
        "gap_hours",
        "rejoined",
        "decoys_linked"
      ],
      "title": "LinkingValidationRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Cross-tile linking tested on real tracks split in two, and on shifted decoys.",
  "properties": {
    "schema_version": {
      "default": "1.2",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "pipeline_version": {
      "description": "Pipeline package version plus the git commit of the code that built the data",
      "title": "Pipeline Version",
      "type": "string"
    },
    "generated_utc": {
      "title": "Generated Utc",
      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "n_tracks": {
      "title": "N Tracks",
      "type": "integer"
    },
    "n_eligible": {
      "title": "N Eligible",
      "type": "integer"
    },
    "completeness": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completeness"
    },
    "completeness_eligible": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completeness Eligible"
