    "false_link_rate_by_offset_arcsec": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "False Link Rate By Offset Arcsec",
      "type": "object"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/LinkingValidationRow"
      },
      "title": "Rows",
      "type": "array"
    }
  },
  "required": [
    "pipeline_version",
    "generated_utc",
    "method",
    "n_tracks",
    "n_eligible",
    "completeness",
    "completeness_eligible",
    "false_link_rate_by_offset_arcsec",
    "rows"
  ],
  "title": "LinkingValidation",
  "type": "object"
}
