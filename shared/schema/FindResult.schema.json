{
  "$defs": {
    "FindBrightness": {
      "additionalProperties": false,
      "properties": {
        "vmag_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vmag Min"
        },
        "vmag_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vmag Max"
        },
        "m50_ab": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Our pipeline's 50% recovery magnitude, from the injection study",
          "title": "M50 Ab"
        },
        "m50_study_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "M50 Study Id"
        },
        "verdict": {
          "enum": [
            "brighter_than_limit",
            "near_limit",
            "fainter_than_limit",
            "unknown"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "note_plain": {
          "title": "Note Plain",
          "type": "string"
        }
      },
      "required": [
        "vmag_min",
        "vmag_max",
        "m50_ab",
        "m50_study_id",
        "verdict",
        "note_plain"
      ],
      "title": "FindBrightness",
      "type": "object"
    },
    "FindCatalogLink": {
      "additionalProperties": false,
      "description": "An object in our own catalog that JPL identified as this body.",
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "report_path": {
          "title": "Report Path",
          "type": "string"
        },
        "n_detections": {
          "title": "N Detections",
          "type": "integer"
        },
        "first_time_utc": {
          "title": "First Time Utc",
          "type": "string"
        },
        "last_time_utc": {
          "title": "Last Time Utc",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "report_path",
        "n_detections",
        "first_time_utc",
        "last_time_utc"
      ],
      "title": "FindCatalogLink",
      "type": "object"
    },
    "FindFrame": {
      "additionalProperties": false,
      "description": "One SPHEREx exposure on one detector whose footprint contains the predicted position.",
      "properties": {
        "frame_id": {
          "description": "obs_id plus detector, e.g. 2025W23_1C_0164_1D2",
          "title": "Frame Id",
          "type": "string"
        },
        "obs_id": {
          "title": "Obs Id",
          "type": "string"
        },
        "detector": {
          "maximum": 6,
          "minimum": 1,
          "title": "Detector",
          "type": "integer"
        },
        "planeid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Planeid"
        },
        "file": {
          "description": "Level 2 file name",
          "title": "File",
          "type": "string"
        },
        "data_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Release"
        },
        "time_utc": {
          "description": "Exposure midpoint",
          "title": "Time Utc",
          "type": "string"
        },
        "mjd": {
          "title": "Mjd",
          "type": "number"
        },
        "time_start_utc": {
          "title": "Time Start Utc",
          "type": "string"
        },
        "time_end_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time End Utc"
        },
        "bandpass": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bandpass"
        },
        "wavelength_um_range": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The detector's wavelength range (IRSA)",
          "title": "Wavelength Um Range"
        },
        "visit": {
          "description": "Index into visits[]",
          "minimum": 0,
          "title": "Visit",
          "type": "integer"
        },
        "predicted": {
          "$ref": "#/$defs/FindPrediction"
        },
        "measured": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindMeasurement"
            },
            {
              "type": "null"
            }
          ]
        },
        "archive_url": {
          "description": "The file in IRSA's public SPHEREx bucket (cutouts read from here)",
          "title": "Archive Url",
          "type": "string"
        },
        "irsa_url": {
          "description": "The file at IRSA",
          "title": "Irsa Url",
          "type": "string"
        },
        "irsa_cutout_url": {
          "description": "IRSA's cutout service around the predicted position (FITS)",
          "title": "Irsa Cutout Url",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "obs_id",
        "detector",
        "planeid",
        "file",
        "data_release",
        "time_utc",
        "mjd",
        "time_start_utc",
        "time_end_utc",
        "bandpass",
        "visit",
        "predicted",
        "measured",
        "archive_url",
        "irsa_url",
        "irsa_cutout_url"
      ],
      "title": "FindFrame",
      "type": "object"
    },
    "FindMatch": {
      "additionalProperties": false,
      "description": "One of several objects SBDB matched to an ambiguous query.",
      "properties": {
        "designation": {
          "title": "Designation",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "designation",
        "name"
      ],
      "title": "FindMatch",
      "type": "object"
    },
    "FindMeasurement": {
      "additionalProperties": false,
      "description": "Our pipeline's own detection of the object in this frame (only frames we measured).",
      "properties": {
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "ra_deg": {
          "title": "Ra Deg",
          "type": "number"
        },
        "dec_deg": {
          "title": "Dec Deg",
          "type": "number"
        },
        "offset_arcsec": {
          "description": "Measured minus predicted position, on the sky",
          "title": "Offset Arcsec",
          "type": "number"
        },
        "flux_ujy": {
          "title": "Flux Ujy",
          "type": "number"
        },
        "flux_err_ujy": {
          "title": "Flux Err Ujy",
          "type": "number"
        },
        "snr": {
          "title": "Snr",
          "type": "number"
        },
        "wavelength_um_center": {
          "title": "Wavelength Um Center",
          "type": "number"
        },
        "band_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Band Index"
        }
      },
      "required": [
        "object_id",
        "candidate_id",
        "ra_deg",
        "dec_deg",
        "offset_arcsec",
        "flux_ujy",
        "flux_err_ujy",
        "snr",
        "wavelength_um_center",
        "band_index"
      ],
      "title": "FindMeasurement",
      "type": "object"
    },
    "FindObject": {
      "additionalProperties": false,
      "properties": {
        "designation": {
          "description": "SBDB primary designation (pdes), e.g. '433' or '2024 YR4'",
          "title": "Designation",
          "type": "string"
        },
        "full_name": {
          "title": "Full Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "asteroid",
            "comet"
          ],
          "title": "Kind",
          "type": "string"
        },
        "numbered": {
          "title": "Numbered",
          "type": "boolean"
        },
        "orbit_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindOrbitClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "diameter_km": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindPhysValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "albedo": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindPhysValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "h_mag": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindPhysValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "sbdb_url": {
          "description": "JPL Small-Body Database page",
          "title": "Sbdb Url",
          "type": "string"
        },
        "horizons_url": {
          "description": "JPL Horizons, the ephemeris service used for the predictions",
          "title": "Horizons Url",
          "type": "string"
        }
      },
      "required": [
        "designation",
        "full_name",
        "kind",
        "numbered",
        "orbit_class",
        "diameter_km",
        "albedo",
        "h_mag",
        "sbdb_url",
        "horizons_url"
      ],
      "title": "FindObject",
      "type": "object"
    },
    "FindOrbitClass": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "code",
        "name"
      ],
      "title": "FindOrbitClass",
      "type": "object"
    },
    "FindPhysValue": {
      "additionalProperties": false,
      "description": "A physical parameter as JPL's Small-Body Database lists it, with its source.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "sigma": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-sigma uncertainty as listed by SBDB, or null",
          "title": "Sigma"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Units"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SBDB's reference for the value (who measured it)",
          "title": "Ref"
        }
      },
      "required": [
        "value",
        "sigma",
        "units",
        "ref"
      ],
      "title": "FindPhysValue",
      "type": "object"
    },
    "FindPrediction": {
      "additionalProperties": false,
      "properties": {
        "ra_deg": {
          "title": "Ra Deg",
          "type": "number"
        },
        "dec_deg": {
          "title": "Dec Deg",
          "type": "number"
        },
        "ra_3sigma_arcsec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Horizons' 3-sigma RA uncertainty, null if not given",
          "title": "Ra 3Sigma Arcsec"
        },
        "dec_3sigma_arcsec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Horizons' 3-sigma Dec uncertainty, null if not given",
          "title": "Dec 3Sigma Arcsec"
        },
        "vmag": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Horizons' predicted visual magnitude (comets: total magnitude T-mag)",
          "title": "Vmag"
        },
        "delta_au": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Distance from Earth's center",
          "title": "Delta Au"
        },
        "method": {
          "description": "Horizons at the exposure midpoint, or interpolated from Horizons' daily table",
          "enum": [
            "horizons_exact",
            "interpolated_daily"
          ],
          "title": "Method",
          "type": "string"
        },
        "observer": {
          "description": "spherex: Horizons computed the position as seen from SPHEREx itself",
          "enum": [
            "spherex",
            "geocenter"
          ],
          "title": "Observer",
          "type": "string"
        }
      },
      "required": [
        "ra_deg",
        "dec_deg",
        "ra_3sigma_arcsec",
        "dec_3sigma_arcsec",
        "vmag",
        "delta_au",
        "method",
        "observer"
      ],
      "title": "FindPrediction",
      "type": "object"
    },
    "FindSearch": {
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "title": "Start Utc",
          "type": "string"
        },
        "end_utc": {
          "title": "End Utc",
          "type": "string"
        },
        "ephemeris_step_days": {
          "title": "Ephemeris Step Days",
          "type": "number"
        },
        "n_tap_queries": {
          "title": "N Tap Queries",
          "type": "integer"
        },
        "services": {
          "description": "Upstream services that answered",
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        },
        "complete": {
          "description": "False when part of the search was skipped (row limit or call budget)",
          "title": "Complete",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "start_utc",
        "end_utc",
        "ephemeris_step_days",
        "n_tap_queries",
        "services",
        "complete",
        "notes"
      ],
      "title": "FindSearch",
      "type": "object"
    },
    "FindVisit": {
      "additionalProperties": false,
      "description": "Frames less than 30 minutes apart from each other, grouped.",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "start_utc": {
          "title": "Start Utc",
          "type": "string"
        },
        "end_utc": {
          "title": "End Utc",
          "type": "string"
        },
        "n_frames": {
          "title": "N Frames",
          "type": "integer"
        },
        "n_measured": {
          "title": "N Measured",
          "type": "integer"
        },
        "predicted_vmag": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Predicted Vmag"
        }
      },
      "required": [
        "index",
        "start_utc",
        "end_utc",
        "n_frames",
        "n_measured",
        "predicted_vmag"
      ],
      "title": "FindVisit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.2",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "pipeline_version": {
      "description": "Pipeline package version plus the git commit of the code that built the data",
      "title": "Pipeline Version",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "status": {
      "enum": [
        "found",
        "ambiguous",
        "not_found"
      ],
      "title": "Status",
      "type": "string"
    },
    "object": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindObject"
        },
        {
          "type": "null"
        }
      ]
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/FindMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "n_frames": {
      "title": "N Frames",
      "type": "integer"
    },
    "n_visits": {
      "title": "N Visits",
      "type": "integer"
    },
    "truncated": {
      "description": "True when more frames matched than are listed",
      "title": "Truncated",
      "type": "boolean"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/FindFrame"
      },
      "title": "Frames",
      "type": "array"
    },
    "visits": {
      "items": {
        "$ref": "#/$defs/FindVisit"
      },
      "title": "Visits",
      "type": "array"
    },
    "catalog": {
      "items": {
        "$ref": "#/$defs/FindCatalogLink"
      },
      "title": "Catalog",
      "type": "array"
    },
    "brightness": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindBrightness"
        },
        {
          "type": "null"
        }
      ]
    },
    "search": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindSearch"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary_plain": {
      "title": "Summary Plain",
      "type": "string"
    },
    "why_it_matters_plain": {
      "title": "Why It Matters Plain",
      "type": "string"
    },
    "query_utc": {
      "title": "Query Utc",
      "type": "string"
    },
    "cached": {
      "title": "Cached",
      "type": "boolean"
    }
  },
  "required": [
    "pipeline_version",
    "query",
    "status",
    "object",
    "matches",
    "n_frames",
    "n_visits",
    "truncated",
    "frames",
    "visits",
    "catalog",
    "brightness",
    "search",
    "summary_plain",
    "why_it_matters_plain",
    "query_utc",
    "cached"
  ],
  "title": "FindResult",
  "type": "object"
}
