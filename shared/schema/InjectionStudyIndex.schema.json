{
  "$defs": {
    "InjectionStudyRef": {
      "additionalProperties": false,
      "properties": {
        "study_id": {
          "title": "Study Id",
          "type": "string"
        },
        "generated_utc": {
          "title": "Generated Utc",
          "type": "string"
        },
        "field_ids": {
          "items": {
            "type": "string"
          },
          "title": "Field Ids",
          "type": "array"
        },
        "n_injected": {
          "title": "N Injected",
          "type": "integer"
        }
