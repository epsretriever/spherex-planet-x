    },
    "studies": {
      "items": {
        "$ref": "#/$defs/InjectionStudyRef"
      },
      "title": "Studies",
      "type": "array"
    }
  },
  "required": [
    "pipeline_version",
    "studies"
  ],
  "title": "InjectionStudyIndex",
  "type": "object"
}
