{
  "$defs": {
    "PlanetNineCell": {
      "additionalProperties": false,
      "properties": {
        "ra_deg": {
          "title": "Ra Deg",
          "type": "number"
        },
        "dec_deg": {
          "title": "Dec Deg",
          "type": "number"
        },
        "fraction": {
          "description": "Share of the remaining population in this RA/Dec cell",
          "title": "Fraction",
          "type": "number"
        }
      },
      "required": [
        "ra_deg",
        "dec_deg",
        "fraction"
      ],
      "title": "PlanetNineCell",
      "type": "object"
    },
    "PlanetNineRegion": {
      "additionalProperties": false,
      "description": "Brown & Batygin's Planet Nine population still open after the ZTF, DES and Pan-STARRS\nsearches, binned on the sky (spherex-px planet-nine).",
      "properties": {
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "epoch_utc": {
          "description": "Sky positions are for this date",
          "title": "Epoch Utc",
          "type": "string"
        },
        "cell_deg": {
          "title": "Cell Deg",
          "type": "number"
        },
        "population": {
          "title": "Population",
          "type": "string"
        },
        "n_population": {
          "title": "N Population",
          "type": "integer"
        },
        "n_remaining": {
          "title": "N Remaining",
          "type": "integer"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/PlanetNineCell"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "citation",
        "url",
        "epoch_utc",
        "cell_deg",
        "population",
        "n_population",
        "n_remaining",
        "cells"
      ],
      "title": "PlanetNineRegion",
      "type": "object"
    },
    "SkyPosition": {
      "additionalProperties": false,
      "properties": {
        "ra_deg": {
          "title": "Ra Deg",
          "type": "number"
        },
        "dec_deg": {
          "title": "Dec Deg",
          "type": "number"
        }
      },
      "required": [
        "ra_deg",
        "dec_deg"
      ],
      "title": "SkyPosition",
      "type": "object"
    },
    "SurveyEmptyCells": {
      "additionalProperties": false,
      "description": "Searched sky where nothing passed vetting, in compact form (survey.json would otherwise\ngrow by a full tile record per searched tile).",
      "properties": {
        "size_deg": {
          "description": "Tile size",
          "title": "Size Deg",
          "type": "number"
        },
        "n_tiles": {
          "description": "Empty tile searches (a patch searched in two weeks counts twice)",
          "title": "N Tiles",
          "type": "integer"
        },
        "positions": {
          "description": "[ra_deg, dec_deg] of each distinct empty patch, rounded to 0.01 deg",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Positions",
          "type": "array"
        }
      },
      "required": [
        "size_deg",
        "n_tiles",
        "positions"
      ],
      "title": "SurveyEmptyCells",
      "type": "object"
    },
    "SurveyRun": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_utc": {
          "title": "Started Utc",
          "type": "string"
        },
        "finished_utc": {
          "title": "Finished Utc",
          "type": "string"
        },
        "pipeline_version": {
          "title": "Pipeline Version",
          "type": "string"
        },
        "n_new_files": {
          "description": "Exposures in tiles this run searched for the first time",
          "title": "N New Files",
          "type": "integer"
        },
        "n_tiles_processed": {
          "description": "Tiles searched in this run",
          "title": "N Tiles Processed",
          "type": "integer"
        },
        "n_new_objects": {
          "description": "Objects published by this run that were not before",
          "title": "N New Objects",
          "type": "integer"
        },
        "segments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Segments",
          "type": "array"
        },
        "n_tiles_with_movers": {
          "default": 0,
          "title": "N Tiles With Movers",
          "type": "integer"
        },
        "n_tiles_empty": {
          "default": 0,
          "title": "N Tiles Empty",
          "type": "integer"
        },
        "n_tiles_failed": {
          "default": 0,
          "title": "N Tiles Failed",
          "type": "integer"
        },
        "n_candidates": {
          "default": 0,
          "title": "N Candidates",
          "type": "integer"
        },
        "workflow_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Url"
        }
      },
      "required": [
        "run_id",
        "started_utc",
        "finished_utc",
        "pipeline_version",
        "n_new_files",
        "n_tiles_processed",
        "n_new_objects"
      ],
      "title": "SurveyRun",
      "type": "object"
    },
    "SurveyTile": {
      "additionalProperties": false,
      "properties": {
        "tile_id": {
          "title": "Tile Id",
          "type": "string"
        },
        "center": {
          "$ref": "#/$defs/SkyPosition"
        },
        "ecliptic_lon_deg": {
          "title": "Ecliptic Lon Deg",
          "type": "number"
        },
        "ecliptic_lat_deg": {
          "title": "Ecliptic Lat Deg",
          "type": "number"
        },
        "size_deg": {
          "title": "Size Deg",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/TileStatus"
        },
        "n_epochs": {
          "title": "N Epochs",
          "type": "integer"
        },
        "n_visits": {
          "title": "N Visits",
          "type": "integer"
        },
        "first_time_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Time Utc"
        },
        "last_time_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Time Utc"
        },
        "last_processed_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Processed Utc"
        },
        "field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Field built for this tile, when processed",
          "title": "Field Id"
        },
        "n_candidates": {
          "title": "N Candidates",
          "type": "integer"
        },
        "m50_ab": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "50% completeness magnitude from injection-recovery, if measured",
          "title": "M50 Ab"
        },
        "m50_study_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Injection study m50_ab comes from",
          "title": "M50 Study Id"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the last search failed",
          "title": "Detail"
        }
      },
      "required": [
        "tile_id",
        "center",
        "ecliptic_lon_deg",
        "ecliptic_lat_deg",
        "size_deg",
        "status",
        "n_epochs",
        "n_visits",
        "first_time_utc",
        "last_time_utc",
        "last_processed_utc",
        "field_id",
        "n_candidates"
      ],
      "title": "SurveyTile",
      "type": "object"
    },
    "SurveyTotals": {
      "additionalProperties": false,
      "properties": {
        "n_tiles": {
          "title": "N Tiles",
          "type": "integer"
        },
        "n_processed": {
          "title": "N Processed",
          "type": "integer"
        },
        "area_deg2_processed": {
          "title": "Area Deg2 Processed",
          "type": "number"
        },
        "n_epochs": {
          "title": "N Epochs",
          "type": "integer"
        },
        "n_candidates": {
          "title": "N Candidates",
          "type": "integer"
        },
        "n_objects": {
          "title": "N Objects",
          "type": "integer"
        },
        "n_known_objects": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Distinct JPL designations among matched objects (added by the Worker)",
          "title": "N Known Objects"
        },
        "n_searched": {
          "default": 0,
          "description": "Tiles searched: processed + empty",
          "title": "N Searched",
          "type": "integer"
        },
        "n_empty": {
          "default": 0,
          "title": "N Empty",
          "type": "integer"
        },
        "n_failed": {
          "default": 0,
          "title": "N Failed",
          "type": "integer"
        },
        "area_deg2_searched": {
          "default": 0.0,
          "description": "Distinct sky searched (a patch searched in several weeks counts once)",
          "title": "Area Deg2 Searched",
          "type": "number"
        },
        "sky_fraction_searched": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "area_deg2_searched / 41,253 deg2 (the whole sky)",
          "title": "Sky Fraction Searched"
        }
      },
      "required": [
        "n_tiles",
        "n_processed",
        "area_deg2_processed",
        "n_epochs",
        "n_candidates",
        "n_objects"
      ],
      "title": "SurveyTotals",
      "type": "object"
    },
    "TileStatus": {
      "enum": [
        "processed",
        "empty",
        "failed",
        "pending",
        "no_data"
      ],
      "title": "TileStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.2",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "pipeline_version": {
      "description": "Pipeline package version plus the git commit of the code that built the data",
      "title": "Pipeline Version",
      "type": "string"
    },
    "build_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build Run Id"
    },
    "generated_utc": {
      "title": "Generated Utc",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "tile_size_deg": {
      "title": "Tile Size Deg",
      "type": "number"
    },
    "data_releases": {
      "items": {
        "type": "string"
      },
      "title": "Data Releases",
      "type": "array"
    },
    "tiles": {
      "description": "Showcase fields, tiles with a field page and failed tiles. Survey tiles searched with nothing found are in empty_cells (since v1.2)",
      "items": {
        "$ref": "#/$defs/SurveyTile"
      },
      "title": "Tiles",
      "type": "array"
    },
    "empty_cells": {
      "anyOf": [
        {
          "$ref": "#/$defs/SurveyEmptyCells"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "totals": {
      "$ref": "#/$defs/SurveyTotals"
    },
    "last_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/SurveyRun"
        },
        {
          "type": "null"
        }
      ]
    },
    "runs": {
      "default": [],
      "description": "Most recent runs first (up to 20)",
      "items": {
        "$ref": "#/$defs/SurveyRun"
      },
      "title": "Runs",
      "type": "array"
    },
    "planet_nine": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanetNineRegion"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Published Planet Nine search region (added by the Worker)"
    }
  },
  "required": [
    "pipeline_version",
    "generated_utc",
    "name",
    "description",
    "tile_size_deg",
    "data_releases",
    "tiles",
    "totals",
    "last_run"
  ],
  "title": "Survey",
  "type": "object"
}
