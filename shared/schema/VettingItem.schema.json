{
  "$defs": {
    "ImageRef": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "width_px": {
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "title": "Height Px",
          "type": "integer"
        },
        "format": {
          "default": "webp",
          "enum": [
            "webp",
            "png"
          ],
          "title": "Format",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "url",
        "width_px",
        "height_px",
        "source"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Provenance for an image, epoch, detection or stamp. Required on every image.",
      "properties": {
        "file": {
          "description": "SPHEREx Level 2 file name",
          "title": "File",
          "type": "string"
        },
        "obs_id": {
          "description": "SPHEREx observation ID (OBSID header keyword)",
          "title": "Obs Id",
          "type": "string"
        },
        "planeid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IRSA CAOM plane ID, when known from an IRSA TAP query",
          "title": "Planeid"
        },
        "detector": {
          "maximum": 6,
          "minimum": 1,
          "title": "Detector",
          "type": "integer"
        },
        "archive_url": {
          "description": "URL of the full Level 2 file in the archive",
          "title": "Archive Url",
          "type": "string"
        },
        "cutout_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IRSA cutout-service URL, when the pixels came from IRSA's cutout service",
          "title": "Cutout Url"
        },
        "cutout_method": {
          "description": "How the pixels were fetched. s3_byte_range reads only the rows of the cutout from the public SPHEREx bucket on AWS; the full file is never downloaded.",
          "enum": [
            "irsa_cutout",
            "s3_byte_range"
          ],
          "title": "Cutout Method",
          "type": "string"
        },
        "cutout_region_pix": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[x_min, x_max, y_min, y_max] (0-based, inclusive-exclusive) of the native detector pixels read",
          "title": "Cutout Region Pix"
        },
        "data_release": {
          "description": "SPHEREx data release, e.g. 'QR2'",
          "title": "Data Release",
          "type": "string"
        },
        "processing_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processing Note"
        }
      },
      "required": [
        "file",
        "obs_id",
        "detector",
        "archive_url",
        "cutout_method",
        "data_release"
      ],
      "title": "Source",
      "type": "object"
    },
    "VettingStamps": {
      "additionalProperties": false,
      "properties": {
        "detection": {
          "$ref": "#/$defs/ImageRef"
        },
        "reference": {
          "$ref": "#/$defs/ImageRef",
          "description": "Same sky from another visit"
        },
        "difference": {
          "$ref": "#/$defs/ImageRef"
        }
      },
      "required": [
        "detection",
        "reference",
        "difference"
      ],
      "title": "VettingStamps",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "pipeline_version": {
      "description": "Pipeline package version plus the git commit of the code that built the data",
      "title": "Pipeline Version",
      "type": "string"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Id"
    },
    "epoch_id": {
      "title": "Epoch Id",
      "type": "string"
    },
    "stamps": {
      "$ref": "#/$defs/VettingStamps"
    },
    "model_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Real-bogus model output in [0, 1]",
      "title": "Model Score"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Version"
    }
  },
  "required": [
    "pipeline_version",
    "item_id",
    "candidate_id",
    "epoch_id",
    "stamps",
    "model_score",
    "model_version"
  ],
  "title": "VettingItem",
  "type": "object"
}
