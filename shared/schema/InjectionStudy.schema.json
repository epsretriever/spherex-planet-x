  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "pipeline_version": {
      "description": "Pipeline package version plus the git commit of the code that built the data",
      "title": "Pipeline Version",
      "type": "string"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "generated_utc": {
      "title": "Generated Utc",
      "type": "string"
    },
    "simulated": {
      "const": true,
      "default": true,
      "title": "Simulated",
      "type": "boolean"
    },
    "field_ids": {
      "items": {
        "type": "string"
      },
      "title": "Field Ids",
      "type": "array"
    },
    "n_injected": {
      "title": "N Injected",
      "type": "integer"
    },
    "n_recovered": {
      "title": "N Recovered",
      "type": "integer"
    },
    "mag_bins_ab": {
      "items": {
        "type": "number"
      },
      "title": "Mag Bins Ab",
      "type": "array"
    },
    "rate_bins_arcsec_per_hr": {
      "items": {
        "type": "number"
      },
      "title": "Rate Bins Arcsec Per Hr",
      "type": "array"
    },
    "grid": {
      "items": {
        "$ref": "#/$defs/RecoveryCell"
      },
      "title": "Grid",
      "type": "array"
    },
    "m50_by_rate": {
      "items": {
        "$ref": "#/$defs/M50"
      },
      "title": "M50 By Rate",
      "type": "array"
    },
    "false_positives": {
      "$ref": "#/$defs/FalsePositives"
    },
    "recovery_criteria": {
      "title": "Recovery Criteria",
      "type": "string"
    },
    "method_notes": {
      "items": {
        "type": "string"
      },
      "title": "Method Notes",
      "type": "array"
    },
    "example_candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Example Candidate Ids",
      "type": "array"
    }
