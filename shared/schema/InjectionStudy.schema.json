  "required": [
    "pipeline_version",
    "study_id",
    "generated_utc",
    "field_ids",
    "n_injected",
    "n_recovered",
    "mag_bins_ab",
    "rate_bins_arcsec_per_hr",
    "grid",
    "m50_by_rate",
    "false_positives",
    "recovery_criteria",
    "method_notes",
    "example_candidate_ids"
  ],
  "title": "InjectionStudy",
  "type": "object"
}
