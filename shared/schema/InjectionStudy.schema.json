          "type": "integer"
        },
        "area_deg2": {
          "title": "Area Deg2",
          "type": "number"
        },
        "n_candidates": {
          "title": "N Candidates",
          "type": "integer"
        },
        "rate_per_deg2": {
          "title": "Rate Per Deg2",
          "type": "number"
        },
        "ci_low_per_deg2": {
          "title": "Ci Low Per Deg2",
          "type": "number"
        },
        "ci_high_per_deg2": {
          "title": "Ci High Per Deg2",
          "type": "number"
        }
      },
      "required": [
        "n_control_runs",
        "area_deg2",
        "n_candidates",
        "rate_per_deg2",
        "ci_low_per_deg2",
        "ci_high_per_deg2"
      ],
      "title": "FalsePositives",
      "type": "object"
    },
    "M50": {
      "additionalProperties": false,
      "properties": {
        "rate_arcsec_per_hr": {
          "title": "Rate Arcsec Per Hr",
          "type": "number"
        },
        "m50_ab": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when 50% completeness is not bracketed",
          "title": "M50 Ab"
        }
      },
      "required": [
        "rate_arcsec_per_hr",
        "m50_ab"
      ],
      "title": "M50",
      "type": "object"
    },
    "RecoveryCell": {
      "additionalProperties": false,
      "properties": {
        "mag_ab": {
          "title": "Mag Ab",
          "type": "number"
        },
        "rate_arcsec_per_hr": {
          "title": "Rate Arcsec Per Hr",
          "type": "number"
        },
        "n_injected": {
          "title": "N Injected",
          "type": "integer"
        },
        "n_recovered": {
          "title": "N Recovered",
          "type": "integer"
        },
        "fraction": {
          "title": "Fraction",
          "type": "number"
        },
        "ci_low": {
          "description": "Wilson 95% interval, lower bound",
          "title": "Ci Low",
          "type": "number"
        },
        "ci_high": {
          "title": "Ci High",
          "type": "number"
        }
      },
      "required": [
        "mag_ab",
        "rate_arcsec_per_hr",
        "n_injected",
        "n_recovered",
        "fraction",
        "ci_low",
        "ci_high"
      ],
      "title": "RecoveryCell",
      "type": "object"
    }
